NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
ANTHROPIC_API_KEY=

# Server-only. Bypasses row level security - never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe. Use test-mode keys (sk_test_...) until you're ready to take real money.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# Where Stripe sends people back to, e.g. https://project-trainer-inky.vercel.app
APP_URL=

# "true" once live Stripe payments are ready. Anything else keeps payments paused.
NEXT_PUBLIC_PAYMENTS_OPEN=

# The Google OAuth web client id (public, not a secret). Without it, the sign-up
# page falls back to the redirect flow, whose Google screen names the Supabase address.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
